//
// STM32F4-Discovery for the 2^30 wrap test.
//
// Same platform as escapement_f4.repl, with one difference: TIM2 is clocked 82,000 times
// faster. The kernel programs a prescaler of 81, so its counter ticks at 10 GHz and
// reaches the 2^30 boundary after 107 ms instead of eighteen minutes. TaskWrapF4 gives its
// tasks periods of 1, 2 and 6 ms in those ticks, close to those of TaskLEDF4 on
// escapement_f4.repl — what shrinks is the emulated time, which a CI runner pays in full.
using "stm32f4_escapement_cpu.repl"

timer2:
    frequency: 820000000000

flash_boot: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

Flag1: Miscellaneous.LED @ gpioPortB
Flag2: Miscellaneous.LED @ gpioPortB
Flag3: Miscellaneous.LED @ gpioPortB

gpioPortB:
    13 -> Flag1@0
    14 -> Flag2@0
    15 -> Flag3@0
