// XOSC: STATUS reads the crystal stable.
xosc: Python.PythonPeripheral @ sysbus 0x40048000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    ready = {0x4: 0x80000000}
elif request.IsRead:
    r = request.Offset & 0xFFF
    request.Value = regs.get(r, 0) | ready.get(r, 0)
else:
    r = request.Offset & 0xFFF
    v = regs.get(r, 0)
    regs[r] = [request.Value, v ^ request.Value, v | request.Value, v & ~request.Value][(request.Offset >> 12) & 3] & 0xFFFFFFFF
'''

// PLL_SYS: CS reads the PLL locked.
pll_sys: Python.PythonPeripheral @ sysbus 0x40050000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    ready = {0x0: 0x80000000}
elif request.IsRead:
    r = request.Offset & 0xFFF
    request.Value = regs.get(r, 0) | ready.get(r, 0)
else:
    r = request.Offset & 0xFFF
    v = regs.get(r, 0)
    regs[r] = [request.Value, v ^ request.Value, v | request.Value, v & ~request.Value][(request.Offset >> 12) & 3] & 0xFFFFFFFF
'''

// WATCHDOG: kept, never fires.
watchdog: Python.PythonPeripheral @ sysbus 0x400D8000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    ready = {}
elif request.IsRead:
    r = request.Offset & 0xFFF
    request.Value = regs.get(r, 0) | ready.get(r, 0)
else:
    r = request.Offset & 0xFFF
    v = regs.get(r, 0)
    regs[r] = [request.Value, v ^ request.Value, v | request.Value, v & ~request.Value][(request.Offset >> 12) & 3] & 0xFFFFFFFF
'''

// TICKS: kept; the timer model counts at 1 MHz regardless.
ticks: Python.PythonPeripheral @ sysbus 0x40108000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    ready = {}
elif request.IsRead:
    r = request.Offset & 0xFFF
    request.Value = regs.get(r, 0) | ready.get(r, 0)
else:
    r = request.Offset & 0xFFF
    v = regs.get(r, 0)
    regs[r] = [request.Value, v ^ request.Value, v | request.Value, v & ~request.Value][(request.Offset >> 12) & 3] & 0xFFFFFFFF
'''
