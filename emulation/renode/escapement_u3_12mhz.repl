//
// escapement_u3.repl for the images built with make MHZ=12: the timers and USART1 count
// the 12 MHz the system clock then runs at, as on the chip, where they follow HCLK (RM0487
// rev. 3, "Timer clock", p. 408), so that their prescalers give the microsecond. For the
// tests of escapement_u3.robot tagged stop2, run with MHZ:12 and this platform.
using "escapement_u3.repl"

nvic:
    systickFrequency: 12000000

timer2:
    frequency: 12000000

timer3:
    frequency: 12000000

timer4:
    frequency: 12000000

usart1:
    frequency: 12000000
