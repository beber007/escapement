// STM32L152 for the power-aware variant of Escapement.
//
// The stm32l151 platform of Renode does not model the PWR block: the writes of
// the DVFS driver to PWR_CR show up in the log but have no effect, and the wait
// loop on PWR_CSR exits immediately. That is enough to observe the range
// changes, not to measure power consumption.
using "stm32l151_escapement_cpu.repl"

// The linker script places the flash at 0x00000000 (STM32 aliasing, BOOT0 = 0).
flash_boot: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00040000

// TaskLEDL1 drives PB12, PB13 and PB14.
Flag1: Miscellaneous.LED @ gpioPortB
Flag2: Miscellaneous.LED @ gpioPortB
Flag3: Miscellaneous.LED @ gpioPortB

gpioPortB:
    12 -> Flag1@0
    13 -> Flag2@0
    14 -> Flag3@0

// The L151 platform of Renode already tags RCC_CR, PWR_CR and PWR_CSR, but not
// RCC_CFGR. The SetSysClock() of ST waits for SWS[3:2] to report the PLL:
// without this it loops forever. The SW[1:0] bits have no effect here.
sysbus:
    init add:
        Tag <0x40023808 4> "RCC_CFGR" 0xC
