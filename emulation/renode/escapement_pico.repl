// Raspberry Pi Pico for Escapement: the board of matgla/Renode_RP2040, checked out
// under emulation/renode/rp2040 (see RP2040.md), with the three other outputs of
// TaskLEDPico declared as LEDs to be testable. GPIO 25, the on-board LED, is already
// one: sysbus.gpio.led.
using "rp2040/boards/raspberry_pico.repl"

flag2: Miscellaneous.LED @ gpio 2
flag3: Miscellaneous.LED @ gpio 3
probe: Miscellaneous.LED @ gpio 4

gpio:
    2 -> flag2@0
    3 -> flag3@0
    4 -> probe@0

// The models leave the voltage regulator out, and the power-aware kernel writes it: VREG
// and BOD keep what is written, ROK reads as in regulation while the regulator is enabled
// and not in high impedance. Offsets from 0x100 hold what rp2040_dvfs_check.py counts.
vreg: Python.PythonPeripheral @ sysbus 0x40064000
    size: 0x1000
    initable: true
    script: '''
if request.IsInit:
    regs = {0x0: 0xB1, 0x4: 0x91, 0x104: 0xF}
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
    if request.Offset == 0x0 and request.Value & 0x3 == 0x1:
        request.Value |= 0x1000
else:
    regs[request.Offset] = request.Value & ~0x1000 if request.Offset == 0x0 else request.Value
'''
