//
// STM32F4-Discovery for Escapement.
//
// Three differences from the platform shipped with Renode:
//  - TIM2 uses the fixed model (see Escapement_STM32_Timer.cs);
//  - the linker script places the flash at 0x00000000 (the STM32 aliasing when
//    BOOT0 = 0), which Renode does not model;
//  - the three tasks of TaskLEDF4 toggle PB13, PB14 and PB15, which have to be
//    declared as LEDs to be testable.
using "stm32f4_escapement_cpu.repl"

UserButton: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@0

UserLED: Miscellaneous.LED @ gpioPortD

flash_boot: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

// TaskLEDF4 drives PB13, PB14 and PB15 (FLAG_PORT = GPIOB).
Flag1: Miscellaneous.LED @ gpioPortB
Flag2: Miscellaneous.LED @ gpioPortB
Flag3: Miscellaneous.LED @ gpioPortB

gpioPortB:
    13 -> Flag1@0
    14 -> Flag2@0
    15 -> Flag3@0

gpioPortD:
    12 -> UserLED@0
