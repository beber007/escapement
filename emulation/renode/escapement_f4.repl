// STM32F4-Discovery pour Escapement.
//
// Trois ecarts avec la plateforme fournie par Renode :
//  - TIM2 utilise le modele corrige (voir Escapement_STM32_Timer.cs) ;
//  - le script de link place la flash en 0x00000000 (aliasing STM32 quand
//    BOOT0 = 0), que Renode ne modelise pas ;
//  - les trois taches de TaskLEDF4 basculent PB13, PB14 et PB15, qu'il faut
//    declarer comme LED pour pouvoir les tester.
using "stm32f4_escapement_cpu.repl"

UserButton: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@0

UserLED: Miscellaneous.LED @ gpioPortD

flash_boot: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

// TaskLEDF4 pilote PB13, PB14 et PB15 (FLAG_PORT = GPIOB).
Flag1: Miscellaneous.LED @ gpioPortB
Flag2: Miscellaneous.LED @ gpioPortB
Flag3: Miscellaneous.LED @ gpioPortB

gpioPortB:
    13 -> Flag1@0
    14 -> Flag2@0
    15 -> Flag3@0

gpioPortD:
    12 -> UserLED@0
