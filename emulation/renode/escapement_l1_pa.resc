:name: Escapement power-aware on STM32L152
:description: Three periodic tasks at 90 percent load, with dynamic adjustment of the core frequency and voltage.

path add @emulation/renode
include @Escapement_STM32_Timer.cs

$elf ?= @Escapement/CORTEX-Mx/STM32/Examples/stm32l-discovery-pa/build/TaskLEDPA.elf
$bin ?= @Escapement/CORTEX-Mx/STM32/Examples/stm32l-discovery-pa/build/TaskLEDPA.bin

mach create "escapement-l1-pa"
machine LoadPlatformDescription @escapement_l1_pa.repl

sysbus LoadELF $elf
sysbus LoadBinary $bin 0x08000000
