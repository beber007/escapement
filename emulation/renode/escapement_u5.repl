// LICENSE at the root of this repository.
//
// The STM32U585 of the Arduino UNO Q for Escapement: a platform of our own, since Renode
// models no STM32U5 (docs/roadmap.md). Only what the examples of Escapement/CORTEX-Mx/
// STM32U5 touch: a Cortex-M33 with its NVIC, 4 bits of priority, 2 MB of flash, the
// 768 KB of SRAM1 to SRAM3 the images run from, TIM2, TIM3 and TIM5 (the fixed timer model
// of the STM32F4 platform, Escapement_STM32_Timer.cs), and the independent watchdog,
// USART1, LPUART1 and ports B, G and H of GPIO, which Renode models for the STM32L552, of
// the same family, with the outputs of BoardU5.h as LEDs, those on port H lit when low as
// on the board; and the blocks the clock set-up waits on. Addresses from RM0456 and
// cmsis-device-u5.
//
// Those blocks keep what is written and read the bits the code waits for as set: the
// voltage range and the booster ready, PLL1 locked, the switch of the system clock
// acknowledged, the LSE started. So this platform checks that the code runs and schedules, not that it
// programs the clocks right: a wrong divider or a missing wait would pass here, and only
// the board tells. The timers count at 160 MHz before their prescaler, the rate
// OSInitializeSystemClocks sets.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 160000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xC0000

timer2: Timers.Escapement_STM32_Timer @ sysbus 0x40000000
    -> nvic@45
    frequency: 160000000
    initialLimit: 0xFFFFFFFF

timer3: Timers.Escapement_STM32_Timer @ sysbus 0x40000400
    -> nvic@46
    frequency: 160000000
    initialLimit: 0xFFFF

timer5: Timers.Escapement_STM32_Timer @ sysbus 0x40000C00
    -> nvic@48
    frequency: 160000000
    initialLimit: 0xFFFFFFFF

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 160000000
    IRQ -> nvic@61

// LPUART1, the link to the board's Linux, as USART1: the registers the driver uses sit at
// the same offsets; the model takes its divisor as a USART's, which only its baud rate
// shows.
lpuart1: UART.STM32F7_USART @ sysbus 0x46002400
    frequency: 160000000
    IRQ -> nvic@66

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    modeResetValue: 0xFFFFFEBF
    outputSpeedResetValue: 0x000000C0
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16
    13 -> flag3@0
    14 -> probe@0

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16
    11 -> flag1@0
    15 -> flag2@0

flag1: Miscellaneous.LED @ gpioPortH 11
    invert: true
flag2: Miscellaneous.LED @ gpioPortH 15
    invert: true
flag3: Miscellaneous.LED @ gpioPortB 13
probe: Miscellaneous.LED @ gpioPortB 14

// RCC: MSIS, HSE and PLL1 ready in CR, SWS in CFGR1 the SW just written, and the LSE and its
// propagation ready in BDCR.
rcc: Python.PythonPeripheral @ sysbus 0x46020C00
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x00: 0x00000035}
elif request.IsRead:
    r = request.Offset
    v = regs.get(r, 0)
    if r == 0x00:
        v |= (1 << 2) | (1 << 17) | (1 << 25)
    elif r == 0x1C:
        v = (v & ~0xC) | ((v & 3) << 2)
    elif r == 0xF0:
        v |= (1 << 1) | (1 << 11)
    request.Value = v
else:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
'''

// PWR: VOSR reads its voltage range and the booster ready.
pwr: Python.PythonPeripheral @ sysbus 0x46020800
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    r = request.Offset
    v = regs.get(r, 0)
    if r == 0x0C:
        v |= (1 << 15) | (1 << 14)
    request.Value = v
else:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
'''

// EXTI: kept as written; the port takes line 23 for the MSI leaving its lock on the LSE,
// which never happens here.
exti: Python.PythonPeripheral @ sysbus 0x46022000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
else:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
'''

// FLASH and ICACHE registers: kept as written, which is all the wait states and the
// enable of the cache need here.
flashRegisters: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
else:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
'''

icache: Python.PythonPeripheral @ sysbus 0x40030400
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
else:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
'''
